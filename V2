-- ⚔️ ระบบ Auto Raid (สเต็ปเดียวจบ ปล่อยเกมรันเองยาวๆ)
-- ==========================================
function autoRaidLoop()
    task.spawn(function()
        local raidState = "Idle" 
        
        while _G.AutoRaid do
            task.wait(1)
            local isEventOpen, timeStr = checkRealTimeEvent()
            
            -- 🚨 Priority: Event เปิด -> ทิ้ง Raid วาร์ปกลับ CapsuleCorp ทันที!
            if _G.AutoEvent and isEventOpen then
                if raidState == "Running" or raidState == "Joining" then
                    StatusLabel.Text = "🚨 Event OPEN! Warping to CapsuleCorp..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                    pcall(function() rs.Remotes.Maps.SelectMap:FireServer("CapsuleCorp") end)
                    raidState = "Idle" 
                    task.wait(8)
                end
                continue 
            end
            
            -- ⚔️ สเต็ปของ Raid
            if raidState == "Idle" then
                raidState = "Joining"
                local currentDiff = _G.RaidDiffs[_G.RaidDiffIndex]
                StatusLabel.Text = "⚔️ Raid | 1. Joining " .. currentDiff .. " Raid..."
                StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 255)
                
                -- สเต็ป 1: เข้า Raid ตามระดับความยากที่เลือก
                pcall(function() rs.Remotes.Maps.SelectRaid:InvokeServer(currentDiff) end)
                
                -- สเต็ป 2: รอโหลด 10 วิ
                StatusLabel.Text = "⚔️ Raid | 2. Waiting 10s for map load..."
                task.wait(10)
                
                -- สเต็ป 3: วางตัว
                if _G.AutoPlaceRaid then
                    StatusLabel.Text = "⚔️ Raid | 3. Placing Towers..."
                    executePlacementsBlocking(_G.PlaceModeRaid, _G.SelectedRaidTeam)
                end
                
                -- สเต็ป 4: กดเริ่ม
                StatusLabel.Text = "⚔️ Raid | 4. Starting Match!"
                task.wait(1)
                pcall(function() rs.Remotes.Maps.StartRaid:InvokeServer() end)
                
                raidState = "Running"
                task.wait(3)
                
            elseif raidState == "Running" then
                -- 🟢 นั่งเฉยๆ! ให้เกมจัดการ Auto-Replay ของมันเอง!
                StatusLabel.Text = "⚔️ Raid | Auto-Farming... (Event " .. timeStr .. ")"
                task.wait(2)
            end
        end
    end)
end

-- ==========================================
-- 🎃 ระบบ Auto Event 
-- ==========================================
function autoEventLoop()
    task.spawn(function()
        local eventState = "Outside"
        while _G.AutoEvent do
            task.wait(1)
            local isEventOpen, timeStr = checkRealTimeEvent()
            
            if isEventOpen then
                if eventState == "Outside" then
                    local currentDiff = _G.EventDiffs[_G.EventDiffIndex]
                    StatusLabel.Text = "✅ Event OPEN | Creating " .. currentDiff .. " Lobby..."
                    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                    
                    -- สร้างห้อง Event ตามระดับความยากที่เลือก
                    pcall(function() rs.Remotes.EventDB.CreateLobby:InvokeServer(currentDiff) end)
                    task.wait(2)
                    pcall(function() rs.Remotes.EventDB.Start:InvokeServer() end)
                    task.wait(1)
                    pcall(function() rs.Remotes.EventDB.Start:InvokeServer() end)
                    
                    StatusLabel.Text = "✅ Event OPEN | Waiting 10s for map..."
                    task.wait(10)
                    eventState = "Inside"
                    
                elseif eventState == "Inside" then
                    if _G.AutoPlaceEvent then
                        StatusLabel.Text = "🎃 Event | Loading Team & Placing..."
                        executePlacementsBlocking(_G.PlaceModeEvent, _G.SelectedEventTeam)
                    end
                    
                    StatusLabel.Text = "🎃 Event | Match in progress... (" .. timeStr .. ")"
                    local matchEnded = false
                    while _G.AutoEvent and not matchEnded do
                        task.wait(2)
                        checkEndMatch(function()
                            -- Event ไม่ได้เริ่มเอง ต้องยิง Start ใหม่ตอนจบเกม
                            pcall(function() rs.Remotes.EventDB.Start:InvokeServer() end)
                            StatusLabel.Text = "🎃 Event | Replaying... Waiting 10s"
                            task.wait(10)
                            matchEnded = true
                            eventState = "Inside" -- กลับไปวางป้อมรอบใหม่
                        end)
                    end
                end
            else
                eventState = "Outside"
                if not _G.AutoRaid then
                    StatusLabel.Text = "⏳ Event CLOSED | " .. timeStr
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
                task.wait(2)
            end
        end
    end)
end

