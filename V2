local function isUIActuallyVisible(guiElement)
    if not guiElement then return false end
    local current = guiElement
    while current and current ~= game do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return true
end

local function clickObject(obj)
    if not obj then return end
    pcall(function()
        if firesignal and obj:IsA("GuiButton") then
            firesignal(obj.MouseButton1Click)
            firesignal(obj.Activated)
        end
        for _, conn in pairs(getconnections(obj.MouseButton1Click or obj.Activated)) do conn:Fire() end
    end)
end

-- 🌟 1. นาฬิกาแบบ Real-Time
local function checkRealTimeEvent()
    local t = os.date("*t")
    local min = t.min
    if min >= 0 and min < 30 then
        return true, string.format("Closes In: %02d:%02d", 29 - min, 59 - t.sec)
    else
        return false, string.format("Opens In: %02d:%02d", 59 - min, 59 - t.sec)
    end
end

-- 🌟 2. ดึงชื่อแมพ
local function getLocation()
    local loc = "Lobby"
    pcall(function()
        if player.PlayerGui then
            for _, gui in pairs(player.PlayerGui:GetDescendants()) do
                if gui:IsA("TextLabel") and gui.Name == "MapName" then
                    local txt = string.lower(gui.Text)
                    if string.find(txt, "wish") or string.find(txt, "nightmare") then
                        loc = "Event"; return
                    elseif txt ~= "" and not string.find(txt, "lobby") then
                        loc = "Match"; return
                    end
                end
            end
        end
    end)
    return loc
end

-- 🌟 3. สแกนหาปุ่ม Replay (สำหรับ Event)
local function checkEndMatch(callback)
    pcall(function()
        if player.PlayerGui then
            for _, gui in pairs(player.PlayerGui:GetDescendants()) do
                if (gui:IsA("TextLabel") or gui:IsA("TextButton")) and isUIActuallyVisible(gui) then
                    local text = string.lower(string.gsub(gui.ContentText ~= "" and gui.ContentText or gui.Text, "<[^>]->", ""))
                    if text == "start" or text == "replay" or text == "play again" or text == "next" then
                        local btn = gui:IsA("GuiButton") and gui or gui:FindFirstAncestorWhichIsA("GuiButton")
                        if btn then clickObject(btn) end
                        if callback then callback() end
                        task.wait(5)
                    elseif text == "lobby" or text == "return" or text == "home" then
                        local btn = gui:IsA("GuiButton") and gui or gui:FindFirstAncestorWhichIsA("GuiButton")
                        if btn then clickObject(btn) end
                        task.wait(5)
                    end
                end
            end
        end
    end)
end

-- 🌟 4. ฟังก์ชันวางตัว 1 ตัว (บังคับรอจนเสร็จ)
local function executePlacementsBlocking(mode, teamNum)
    if mode == "EquipBest" then
        pcall(function() rs.Remotes.Towers.EquipBestTowers:InvokeServer() end)
    else
        pcall(function() rs.Remotes.Towers.LoadTeamLoadout:InvokeServer(teamNum) end)
    end
    task.wait(2.5) 
    for attempt = 1, 10 do
        local placed = false
        pcall(function()
            local placeRemote = rs.Remotes.Towers.PlaceTower
            if placeRemote then
                for _, v in pairs(player.PlayerGui:GetDescendants()) do
                    if v:IsA("StringValue") and string.find(string.lower(v.Name), "uuid") and #v.Value > 20 then
                        placeRemote:FireServer(v.Value, CFrame.new(0,0,0))
                        placed = true; break 
                    end
                end
            end
        end)
        if placed then return true end
        task.wait(1) 
    end
end

