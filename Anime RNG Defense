end)

local function getActivePriority()
    local activePriority = {}
    for i = selectedRankIndex, #allPortals do
        table.insert(activePriority, allPortals[i])
    end
    return activePriority
end

local function forceLoadInventory()
    pcall(function()
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local drops = playerGui:FindFirstChild("Drops")
            if drops then
                local display = drops:FindFirstChild("Display")
                if display then
                    display.Visible = true
                    task.wait(0.4)
                    display.Visible = false
                end
            end
        end
    end)
end

local function getMapName()
    for _, gui in pairs(player.PlayerGui:GetDescendants()) do
        if gui.Name == "MapName" and gui:IsA("TextLabel") then
            return gui.Text or ""
        end
    end
    return ""
end

local function getBestPortalUUID()
    local foundPortals = {}
    local activePriority = getActivePriority()

    -- 1. สแกนจาก Memory
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" then
            pcall(function()
                for key, val in pairs(obj) do
                    if type(val) == "table" then
                        local currentPortalName = nil
                        for _, v in pairs(val) do
                            if type(v) == "string" then
                                for _, pName in ipairs(activePriority) do
                                    if v == pName then currentPortalName = pName; break end
                                end
                            end
                            if currentPortalName then break end
                        end
                        if currentPortalName and not foundPortals[currentPortalName] then
                            if type(key) == "string" and #key >= 30 and string.find(key, "-") then
                                foundPortals[currentPortalName] = key
                            end
                            for _, v in pairs(val) do
                                if type(v) == "string" and #v >= 30 and string.find(v, "-") then
                                    foundPortals[currentPortalName] = v; break
                                end
                            end
                        end
                    end
                end
            end)
        end
        if foundPortals[activePriority[1]] then break end 
    end

    -- 2. สแกนจาก UI DropVirtualItem หากใน Memory ไม่พบ
    if not foundPortals[activePriority[1]] then
        pcall(function()
            local scroll = player.PlayerGui.Drops.Display.Frame.ScrollingFrame
            for _, item in pairs(scroll:GetChildren()) do
                if item.Name == "DropVirtualItem" then
                    local content = item:FindFirstChild("Content")
                    local nameLabel = content and content:FindFirstChild("Name")
                    if nameLabel and nameLabel:IsA("TextLabel") then
                        for _, pName in ipairs(activePriority) do
                            if nameLabel.Text == pName and not foundPortals[pName] then
                                for attrName, val in pairs(item:GetAttributes()) do
                                    if type(val) == "string" and #val >= 30 and string.find(val, "-") then
                                        foundPortals[pName] = val
                                    end
                                end
                                for _, child in pairs(item:GetChildren()) do
                                    if child:IsA("StringValue") and #child.Value >= 30 and string.find(child.Value, "-") then
                                        foundPortals[pName] = child.Value
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    for _, pName in ipairs(activePriority) do
        if foundPortals[pName] then return foundPortals[pName], pName end
    end
    return nil, nil
end

local function clickStart()
    pcall(function()
        local startRemote = rs:WaitForChild("Remotes", 3):WaitForChild("Coop", 3):WaitForChild("Start", 3)
        if startRemote then startRemote:InvokeServer() end
    end)
end

-- 🌟 ปรับเปลี่ยนเป็น Remote ยิง EquipBestTowers
local function executePlacements()
    pcall(function()
        local equipRemote = rs:WaitForChild("Remotes", 3):WaitForChild("Towers", 3):WaitForChild("EquipBestTowers", 3)
        if equipRemote then
            equipRemote:InvokeServer()
        end
    end)
end

local function autoPortalLoop()
    task.spawn(function()
        local hasPlacedTowers = false

        while _G.AutoPortal do
            local currentMap = getMapName()
            local mapLower = string.lower(currentMap)

            -- ==========================================
            -- ⚔️ 1. อยู่ในแมพ Solo Island
            -- ==========================================
            if string.find(mapLower, "solo island") then
                StatusLabel.Text = "In Match: Solo Island"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)

                if _G.AutoPlace and not hasPlacedTowers then
                    StatusLabel.Text = "Equipping Best Towers..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 255)
                    executePlacements()
                    
                    task.wait(1)
                    StatusLabel.Text = "Clicking Start..."
                    clickStart()
                    
                    hasPlacedTowers = true
                end

                task.wait(2)

            -- ==========================================
            -- 🏠 2. อยู่ในแมพ Eisenbern Castle (Lobby)
            -- ==========================================
            else
                hasPlacedTowers = false 

                StatusLabel.Text = "Loading Inventory..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                
                forceLoadInventory()

                StatusLabel.Text = "Lobby: Scanning Portals..."
                local uuid, portalName = getBestPortalUUID()

                if uuid then
                    StatusLabel.Text = "Found: " .. portalName
                    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

                    pcall(function()
                        activateRemote:InvokeServer(uuid)
                    end)

                    StatusLabel.Text = "Entering Dungeon..."
                    StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
                    task.wait(7)

                    StatusLabel.Text = "Clicking Start (1)..."
                    clickStart()

                    task.wait(3)
                else
                    StatusLabel.Text = "No Portals! Retrying..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                    task.wait(3)
                end
            end
        end

        StatusLabel.Text = "Status: Idle"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end)
end

